---
import BaseLayout from './BaseLayout.astro';
import ContextSwitcher from '../components/ContextSwitcher.astro';
import { site, portfolioNav } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<BaseLayout title={title} description={description} section="portfolio">
  <header class="site-header" transition:name="shell" transition:animate="none">
    <div class="shell bar">
      <a class="wordmark" href="/">{site.shortName}</a>

      <nav class="links" aria-label="Portfolio">
        <ul>
          {
            portfolioNav.map((item) => {
              const active = item.href === '/' ? path === '/' : path.startsWith(item.href);
              return (
                <li>
                  <a href={item.href} aria-current={active ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <ContextSwitcher current="portfolio" />
    </div>
  </header>

  <main id="main" transition:animate="slide">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="shell foot">
      <p class="who">{site.name}</p>
      <ul class="social">
        <li><a href={site.links.github} rel="me noopener">GitHub</a></li>
        <li><a href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>
        <li><a href="/ilp">CSUMB ILP</a></li>
      </ul>
    </div>
  </footer>
</BaseLayout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 64px;
    padding-block: var(--space-2xs);
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
  }

  .links ul {
    display: flex;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
  }

  .links a:hover {
    color: var(--fg);
  }

  .links a[aria-current='page'] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--space-2xl);
    padding-block: var(--space-l);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .who {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .social {
    display: flex;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .social a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 1px;
  }

  .social a:hover {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 560px) {
    .bar {
      gap: var(--space-s);
    }

    .wordmark {
      width: 100%;
      margin-right: 0;
    }
  }
</style>
