---
import StatusBadge from './StatusBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  course: CollectionEntry<'courses'>;
  /** Set when the term block holds more than one course. */
  showUnits?: boolean;
}

const { course, showUnits = false } = Astro.props;
const { code, title, units, status, fulfills } = course.data;
---

<a class="course" href={`/ilp/courses/${course.id}`} data-status={status}>
  <div class="head">
    <span class="code">{code}</span>
    <StatusBadge status={status} />
  </div>
  <h3>{title}</h3>
  {/* A single-course block already states its units in the header, so units are
      only shown here when a block is shared and the split is not otherwise visible. */}
  {
    (showUnits || fulfills) && (
      <p class="meta">
        {showUnits && <span>{units} units</span>}
        {fulfills && <span class="fulfills">{fulfills}</span>}
      </p>
    )
  }
</a>

<style>
  .course {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: var(--space-s);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .course:hover {
    border-color: var(--csumb-ocean);
    border-left-color: var(--csumb-blue);
    transform: translateY(-1px);
  }

  .course[data-status='complete'] {
    border-left-color: #689466;
  }

  .course[data-status='in-progress'] {
    border-left-color: var(--csumb-sunshine);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: 0.4rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--csumb-blue);
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    margin: 0 0 0.3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .meta {
    gap: 0.5rem;
  }

  .fulfills {
    display: inline-block;
  }

  @media (prefers-reduced-motion: reduce) {
    .course {
      transition: none;
    }
    .course:hover {
      transform: none;
    }
  }
</style>
