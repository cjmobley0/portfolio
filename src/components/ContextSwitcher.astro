---
/**
 * The seam between the two sections.
 *
 * A two-segment control rendered in the same position in both headers, on every
 * page of both sections. It always shows which side you are on and gives exactly
 * one obvious way to cross — so moving between the personal portfolio and the
 * academic one is never a dead end or a guess.
 */

interface Props {
  current: 'portfolio' | 'ilp';
}

const { current } = Astro.props;

const segments = [
  { id: 'portfolio', href: '/', label: 'Portfolio', hint: 'Personal work' },
  { id: 'ilp', href: '/ilp', label: 'ILP', hint: 'CSUMB coursework' },
] as const;
---

<nav class="switcher" aria-label="Site section">
  <ul>
    {
      segments.map((seg) => {
        const active = seg.id === current;
        return (
          <li>
            {/* "true" rather than "page": this marks the active SECTION, and the
                target is usually not the page you are on. The in-section nav uses
                aria-current="page" for that. */}
            <a
              href={seg.href}
              aria-current={active ? 'true' : undefined}
              data-active={active ? 'true' : undefined}
            >
              <span class="label">{seg.label}</span>
              <span class="hint">{seg.hint}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .switcher ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 3px;
    list-style: none;
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  a:hover {
    color: var(--fg);
  }

  a[data-active] {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.3;
  }

  /* The hint is what stops the control being a bare toggle — it says what is on
     the other side before you click it. Dropped on small screens for room. */
  .hint {
    font-size: 0.68rem;
    line-height: 1.2;
    opacity: 0.75;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .hint {
      display: none;
    }

    a {
      padding-block: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
